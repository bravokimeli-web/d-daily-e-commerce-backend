PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ddaily

# M-Pesa Daraja (production)
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your_production_consumer_key
MPESA_CONSUMER_SECRET=your_production_consumer_secret
MPESA_SHORTCODE=your_till_shortcode_from_daraja
MPESA_PASSKEY=your_production_passkey
MPESA_CALLBACK_URL=https://api.ddaily.co.ke/api/webhooks/mpesa
# Till number (Buy Goods): CustomerBuyGoodsOnline | Paybill: CustomerPayBillOnline
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Note: the current backend implementation uses MPESA_BASE_URL and MPESA_CALLBACK_URL
# directly. If you keep the following production URL placeholders, they are optional
# and not required by the current code.
# MPESA_OAUTH_URL=https://api.safaricom.co.ke/oauth/v1/generate
# MPESA_STKPUSH_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com
SITEMAP_URL=http://localhost:5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin auth
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
SETUP_TOKEN=your_secure_setup_token
